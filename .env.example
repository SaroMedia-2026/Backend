# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (Safe for client, used for public read / token validation verification)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service Role Key (SECRET: Used ONLY on the backend to bypass RLS for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Configuration
# Found in Cloudinary Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Admin Seed Configuration (used by npm run seed)
SEED_ADMIN_EMAIL=admin@saroagency.com
SEED_ADMIN_PASSWORD=AdminSecurePassword123!
SEED_ADMIN_NAME=Agency Admin
